{
  "name": "mcp-server-corpayone",
  "version": "1.0.0",
  "description": "Policy-aware MCP server for the Corpay One API (read-first, write-gated).",
  "type": "module",
  "main": "./dist/transports/stdio.js",
  "exports": {
    ".": "./dist/transports/stdio.js",
    "./gateway": {
      "types": "./dist/gateway.d.ts",
      "default": "./dist/gateway.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    ".env.example"
  ],
  "bin": {
    "mcp-server-corpayone": "./dist/transports/stdio.js"
  },
  "scripts": {
    "build": "tsup src/transports/stdio.ts src/transports/http.ts src/gateway.ts --format esm --dts --clean --sourcemap",
    "dev": "tsx src/transports/stdio.ts",
    "auth:grant": "tsx src/auth/capture-token.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "npm run build",
    "prepack": "npm run typecheck && npm test && npm run build",
    "dev:http": "tsx src/transports/http.ts",
    "smoke:live": "tsx test/live-smoke.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/borgels/mcp-server-corpayone.git"
  },
  "keywords": [
    "mcp",
    "corpay",
    "corpay-one",
    "accounts-payable",
    "bills",
    "expenses",
    "ap-automation"
  ],
  "author": "",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.11"
  },
  "bugs": {
    "url": "https://github.com/borgels/mcp-server-corpayone/issues"
  },
  "homepage": "https://github.com/borgels/mcp-server-corpayone#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "ip-address": ">=10.3.1",
    "hono": ">=4.12.34",
    "fast-uri": ">=3.1.5",
    "@hono/node-server": ">=1.19.15"
  }
}
