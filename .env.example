# Corpay One OAuth 2.0 app credentials. Read from the server environment only,
# never from tool arguments. Create an app at
# https://app.corpayone.com/developers, then run `npm run auth:grant` once to
# capture a refresh token with the scopes this server needs.
CORPAYONE_CLIENT_ID=
CORPAYONE_CLIENT_SECRET=
# Long-lived refresh token from the authorization-code grant (offline_access).
CORPAYONE_REFRESH_TOKEN=

# Environment: "staging" (default) or "production". Selects the API and
# identity hosts.
CORPAYONE_ENV=staging

# Team (company) id. Setting it scopes the server to exactly one company: the
# team is forced into every request, and a request naming a different team is
# rejected. Leave empty to let callers choose (single-user setups only).
# Find ids with the corpay_list_teams tool.
CORPAYONE_TEAM_ID=

# Write policy. Both default to off.
#   WRITES    — coding, vendors, coding lists, webhooks
#   APPROVALS — approve/decline an expense, which releases it for payment
CORPAYONE_ENABLE_WRITES=false
CORPAYONE_ENABLE_APPROVALS=false
# Optional JSON file to narrow (or widen) the policy, incl. maxAmount in minor units.
CORPAYONE_POLICY_PATH=
# Optional path for the JSON-lines write audit log.
CORPAYONE_AUDIT_LOG=

# Secret used to validate inbound webhook signatures (X-Roger-Signature).
CORPAYONE_WEBHOOK_SECRET=

# Redirect URI registered on the Corpay One app (used by `npm run auth:grant`).
CORPAYONE_REDIRECT_URI=http://localhost:53682/corpayone/callback
# Override the scopes requested by `npm run auth:grant`.
CORPAYONE_SCOPE=

# Optional explicit host overrides (otherwise derived from CORPAYONE_ENV). https only.
CORPAYONE_API_BASE_URL=
CORPAYONE_IDENTITY_BASE_URL=
CORPAYONE_TIMEOUT_MS=30000

# Streamable HTTP transport. Binds to loopback and expects a reverse proxy in
# front that terminates TLS and authenticates callers.
MCP_HTTP_HOST=127.0.0.1
PORT=3000
MCP_MAX_BODY_BYTES=10485760
MCP_ALLOWED_ORIGINS=
MCP_ALLOW_ANY_ORIGIN=false
MCP_HTTP_TOKEN=
